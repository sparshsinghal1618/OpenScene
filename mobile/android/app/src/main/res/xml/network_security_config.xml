<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted for the loopback origin only. The bundled web app is
     served from http://127.0.0.1:<ephemeral>/ so it gets a real, stable origin
     (IndexedDB + service worker behaviour matches the desktop app). Nothing else
     is allowed to use cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
